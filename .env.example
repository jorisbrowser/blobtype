# Easiest: use the settings window (left-click the tray icon); it writes this file for you.
# Copy to %APPDATA%\blobtype\.env (or put next to where you start the app) and
# fill in only the provider you use. Real environment variables win over this file.

GROQ_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# Optional key for a self-hosted OpenAI-compatible server:
OPENAI_COMPATIBLE_API_KEY=
